# NordVPN service credentials required by gluetun
NORDVPN_SERVICE_USER=
NORDVPN_SERVICE_PASSWORD=

# Optional country hint for the VPN exit server
NORDVPN_COUNTRY=United States

# Optional host user/group mapping for the container services
PUID=1000
PGID=1000
TZ=Etc/UTC

# Optional volume overrides
QBIT_CONFIG_DIR=./data/qbit
JACKETT_CONFIG_DIR=./data/jackett
TORRENT_DOWNLOADS=./data/downloads
